# Optional live reputation providers
GOOGLE_API_KEY=
VIRUSTOTAL_API_KEY=

# Dedicated HMAC key for short-lived VirusTotal status tokens.
# Use a random value of at least 32 bytes in production.
STATUS_SIGNING_KEY=

# Dedicated HMAC key for privacy-preserving, daily-rotating rate-limit buckets.
# Use a different random value of at least 32 bytes in production.
RATE_LIMIT_SIGNING_KEY=

# Cloudflare Turnstile. Configure both values together.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Test-only escape hatch. Never set to true in production.
DISABLE_EXTERNAL_CHECKS=false
